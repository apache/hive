PREHOOK: query: CREATE CONNECTOR IF NOT EXISTS mysql_props_dc
TYPE 'mysql'
URL 'jdbc:mysql://nightly1.apache.org:3306/hive1'
COMMENT 'test connector'
WITH DCPROPERTIES (
"hive.sql.dbcp.username"="hive1",
"hive.sql.dbcp.password"="hive1",
"hive.connector.autoReconnect"="true",
"hive.connector.maxReconnects"="3")
PREHOOK: type: CREATEDATACONNECTOR
PREHOOK: Output: connector:mysql_props_dc
POSTHOOK: query: CREATE CONNECTOR IF NOT EXISTS mysql_props_dc
TYPE 'mysql'
URL 'jdbc:mysql://nightly1.apache.org:3306/hive1'
COMMENT 'test connector'
WITH DCPROPERTIES (
"hive.sql.dbcp.username"="hive1",
"hive.sql.dbcp.password"="hive1",
"hive.connector.autoReconnect"="true",
"hive.connector.maxReconnects"="3")
POSTHOOK: type: CREATEDATACONNECTOR
POSTHOOK: Output: connector:mysql_props_dc
PREHOOK: query: DESCRIBE CONNECTOR mysql_props_dc
PREHOOK: type: DESCDATACONNECTOR
PREHOOK: Input: connector:mysql_props_dc
POSTHOOK: query: DESCRIBE CONNECTOR mysql_props_dc
POSTHOOK: type: DESCDATACONNECTOR
POSTHOOK: Input: connector:mysql_props_dc
mysql_props_dc	mysql	jdbc:mysql://nightly1.apache.org:3306/hive1	hive_test_user	USER	test connector
PREHOOK: query: DESCRIBE CONNECTOR EXTENDED mysql_props_dc
PREHOOK: type: DESCDATACONNECTOR
PREHOOK: Input: connector:mysql_props_dc
POSTHOOK: query: DESCRIBE CONNECTOR EXTENDED mysql_props_dc
POSTHOOK: type: DESCDATACONNECTOR
POSTHOOK: Input: connector:mysql_props_dc
mysql_props_dc	mysql	jdbc:mysql://nightly1.apache.org:3306/hive1	hive_test_user	USER	test connector	{hive.connector.autoReconnect=true, hive.connector.maxReconnects=3, hive.sql.dbcp.password=(withheld), hive.sql.dbcp.username=(withheld)}
PREHOOK: query: DROP CONNECTOR mysql_props_dc
PREHOOK: type: DROPDATACONNECTOR
PREHOOK: Input: connector:mysql_props_dc
PREHOOK: Output: connector:mysql_props_dc
POSTHOOK: query: DROP CONNECTOR mysql_props_dc
