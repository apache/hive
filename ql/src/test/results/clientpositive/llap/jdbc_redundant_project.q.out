PREHOOK: query: EXPLAIN CBO
WITH cross_items AS (
  SELECT id
  FROM (
    SELECT id FROM country_bob
    INTERSECT
    SELECT id FROM country_alice
    INTERSECT
    SELECT id FROM country_bob
  ) x
)
SELECT channel, cnt
FROM (
  SELECT 'a' channel, COUNT(*) cnt
  FROM country_bob
  WHERE id IN (SELECT id FROM cross_items)
  UNION ALL
  SELECT 'b' channel, COUNT(*) cnt
  FROM country_alice
  WHERE id IN (SELECT id FROM cross_items)
  UNION ALL
  SELECT 'c' channel, COUNT(*) cnt
  FROM country_bob
  WHERE id IN (SELECT id FROM cross_items)
) y
ORDER BY channel
