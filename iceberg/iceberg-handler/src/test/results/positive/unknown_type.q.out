PREHOOK: query: MERGE INTO unknown_test_middle t
USING (SELECT 3 AS a, 33 AS c UNION ALL SELECT 4 AS a, 40 AS c) s
ON t.a = s.a
WHEN MATCHED THEN UPDATE SET c = s.c
WHEN NOT MATCHED THEN INSERT (a, c) VALUES (s.a, s.c)
PREHOOK: type: QUERY
PREHOOK: Input: _dummy_database@_dummy_table
PREHOOK: Input: default@unknown_test_middle
PREHOOK: Output: default@merge_tmp_table
PREHOOK: Output: default@unknown_test_middle
PREHOOK: Output: default@unknown_test_middle
POSTHOOK: query: MERGE INTO unknown_test_middle t
USING (SELECT 3 AS a, 33 AS c UNION ALL SELECT 4 AS a, 40 AS c) s
ON t.a = s.a
WHEN MATCHED THEN UPDATE SET c = s.c
WHEN NOT MATCHED THEN INSERT (a, c) VALUES (s.a, s.c)
