PREHOOK: query: create materialized view mat1 stored by iceberg stored as orc tblproperties ('format-version'='3') as
select t1.b, sum(t2.f), count(*)
from t1 join t2 on t1.a = t2.d
where t1.c > 50
group by t1.b
