CBO PLAN:
HiveProject(tbl_ice.a=[$0], _c1=[$1])
  HiveAggregate(group=[{0}], agg#0=[count($2)])
    HiveTableScan(table=[[default, tbl_ice]], table:alias=[tbl_ice])

